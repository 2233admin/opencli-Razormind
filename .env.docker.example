COMPOSE_PROJECT_NAME=opencli-admin
DOCKER_REGISTRY=ghcr.io/
DOCKER_IMAGE_NAMESPACE=2233admin
IMAGE_TAG=0.4.1

FRONTEND_PORT=3010
API_PORT=8031
PUBLIC_URL=http://localhost:8031

# API transport token is required for non-localhost binds and Fleet/Agent/API
# integrations. The installer generates it automatically.
API_AUTH_TOKEN=
# Required emergency/OIDC bootstrap token; the installer generates it.
BOOTSTRAP_ADMIN_TOKEN=
SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=

# The installer creates this password hash and its initialization marker in
# db_data before starting the API. There is no public default password.
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD_HASH=
LOCAL_AUTH_STATE_PATH=/data/local-admin-password.hash

DATABASE_URL=sqlite+aiosqlite:////data/opencli_admin.db
TASK_EXECUTOR=local
COLLECTION_MODE=local
DEBUG=false

# Optional External Analysis Runtime. The default Compose stack does not start
# or require it; opt in with: docker compose --profile analysis-runtime up -d questdb
QUESTDB_ANALYSIS_RUNTIME_ENABLED=false
QUESTDB_ANALYSIS_RUNTIME_URL=http://questdb:9000
QUESTDB_ANALYSIS_RUNTIME_HEALTH_URL=http://questdb:9003
QUESTDB_ANALYSIS_RUNTIME_TIMEOUT_SECONDS=2
QUESTDB_HTTP_PORT=9000
QUESTDB_HEALTH_PORT=9003

# Interactive browser is available at http://localhost:6080.
OPENCLI_CDP_ENDPOINT=http://agent-1:19222
NOVNC_PORT=6080
NOVNC_BASE_PORT=6080

# Remote-agent defaults.
AGENT_MODE=bridge
OPENCLI_DAEMON_PORT=19825
CHROME_SUFFIX=
