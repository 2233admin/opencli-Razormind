{
  "name": "opencli-admin",
  "private": true,
  "version": "0.4.0",
  "workspaces": [
    "chrome/extension-src"
  ],
  "scripts": {
    "dev": "nx run extension:dev",
    "dev:frontend": "node scripts/frontend.mjs dev",
    "dev:backend": "uv run uvicorn backend.main:app --host 127.0.0.1 --port 8031 --reload",
    "sync:backend": "uv sync --extra dev",
    "test:backend": "uv run pytest --no-cov",
    "lint:backend:all": "uv run ruff check backend tests",
    "format:backend": "uv run ruff format backend tests",
    "check:backend": "uv run python -m compileall -q backend",
    "build:frontend": "node scripts/frontend.mjs build",
    "lint:frontend": "node scripts/frontend.mjs lint",
    "typecheck:frontend": "node scripts/frontend.mjs typecheck",
    "check": "npm run check:backend && npm run lint:frontend && npm run typecheck:frontend",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.build.yml up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200",
    "dev:extension": "nx run extension:dev",
    "build": "nx run extension:build",
    "build:extension": "nx run extension:build",
    "test": "nx run-many --target=test --all --parallel",
    "typecheck": "nx run-many --target=typecheck --all --parallel",
    "format": "nx format:write",
    "lint": "nx run-many --target=lint --all --parallel",
    "nx": "nx"
  },
  "devDependencies": {
    "nx": "^20.6.0"
  }
}
